PORT=3000
LOG_LEVEL=info

# BD en el servidor legacy onx-erptycqsa — 3306 no esta abierto directo hacia
# EasyPanel, solo via SSH (vpaz@100.27.20.188). El servicio db-tunnel del
# docker-compose abre ese tunel y expone 3306 en la red interna del compose.
# La llave privada va en ./ssh/vpaz.pem (NO se sube al repo, ver .gitignore).
DB_HOST=db-tunnel
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=erptycqsa

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

N8N_WEBHOOK_SEND_MESSAGE=
N8N_WEBHOOK_SEND_ALERT=
N8N_WEBHOOK_SEND_REPORT=

UMBRAL_RENDIMIENTO_PCT=70
UMBRAL_TANQUE_PCT=20
HORARIO_INICIO=06:00
HORARIO_FIN=22:00
